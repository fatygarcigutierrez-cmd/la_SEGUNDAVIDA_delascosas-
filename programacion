<style>
:root{--verde:#2f6b4f;--verde2:#7fb08c;--tierra:#8a6a4f;--crema:#f6f3ec;--carbon:#1e1c19;--gris:#6b6660;--rojo:#a8443a;--azul:#3d6689;--linea:rgba(30,28,25,.14);--sombra:0 18px 40px -24px rgba(30,28,25,.45);--radio:18px}
