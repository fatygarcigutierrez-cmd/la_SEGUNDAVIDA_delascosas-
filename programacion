body{font-family:Inter,Arial,sans-serif;background:var(--crema);color:var(--carbon);line-height:1.6;overflow-x:hidden;transition:background .25s,color .25s}
body.noche{--crema:#1d211d;--carbon:#f1eee6;--gris:#b8b3a9;--linea:rgba(246,243,236,.17);--sombra:0 18px 40px -24px #000;background:#1d211d}
h1,h2,h3,.serif{font-family:Georgia,serif;line-height:1.1}button{font:inherit}
.contenedor{width:min(1120px,92vw);margin:auto}
.hero{min-height:88vh;display:flex;align-items:center;padding:6rem 0 4rem;position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;inset:-20% -10% auto;height:75%;background:radial-gradient(60% 60% at 20% 30%,rgba(127,176,140,.35),transparent 70%),radial-gradient(50% 50% at 80% 20%,rgba(138,106,79,.22),transparent 70%);filter:blur(10px);animation:flotar 18s ease-in-out infinite alternate}
@keyframes flotar{to{transform:translateY(-24px) scale(1.06)}}
.hero .contenedor{position:relative}.marca{color:var(--verde);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;margin-bottom:2rem}
.ods{display:inline-block;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gris);border:1px solid var(--linea);border-radius:99px;padding:.45rem 1rem;margin-bottom:1.5rem}
.hero h1{font-size:clamp(2.8rem,8vw,5.8rem);letter-spacing:-.03em;margin-bottom:1.2rem}.hero h1 em{color:var(--verde);font-weight:400}
.gancho{font-size:clamp(1.05rem,2.2vw,1.35rem);max-width:38ch;margin-bottom:1.3rem}.cita{font-family:Georgia,serif;font-style:italic;color:var(--gris);border-left:2px solid var(--verde2);padding-left:1.1rem;margin-bottom:2.2rem}
.boton,.boton-secundario{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.9rem 1.35rem;border-radius:999px;border:1px solid transparent;cursor:pointer;text-decoration:none;font-weight:600;transition:.2s}
.boton{background:var(--carbon);color:var(--crema)}.boton:hover{background:var(--verde);transform:translateY(-2px)}
.boton-secundario{background:transparent;border-color:var(--linea);color:var(--carbon)}.boton-secundario:hover{border-color:var(--carbon);background:rgba(127,176,140,.1)}
section{padding:4.5rem 0}.titulo-seccion{font-size:clamp(1.8rem,4vw,2.8rem);margin-bottom:.8rem}.bajada{color:var(--gris);max-width:65ch;margin-bottom:2rem}
.juego{background:rgba(255,255,255,.55);border:1px solid var(--linea);border-radius:var(--radio);padding:2rem;box-shadow:var(--sombra)}
.noche .juego,.noche .objeto,.noche .modal{background:#282e28}
.juego-cabecera{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.3rem}
.contador{display:flex;gap:1.3rem;flex-wrap:wrap;font-family:Georgia,serif}.salvados b{color:var(--verde2)}.desechados b{color:var(--tierra)}.puntaje b{color:var(--verde)}
.progreso{height:8px;background:rgba(127,176,140,.2);border-radius:20px;overflow:hidden;margin:0 0 1.4rem}.progreso span{display:block;height:100%;width:0;background:var(--verde);transition:width .3s}
.filtros{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.5rem}.filtro{background:transparent;border:1px solid var(--linea);border-radius:99px;padding:.5rem .9rem;color:var(--gris);cursor:pointer}.filtro.activo{background:var(--carbon);color:var(--crema);border-color:var(--carbon)}
.rejilla-objetos{display:grid;grid-template-columns:repeat(auto-fill,minmax(165px,1fr));gap:1rem}
.objeto{background:var(--crema);border:1px solid var(--linea);border-radius:14px;padding:1.3rem .8rem;text-align:center;cursor:pointer;color:var(--carbon);transition:.2s}
.objeto:hover{transform:translateY(-4px);box-shadow:var(--sombra);border-color:var(--verde2)}.objeto:focus-visible{outline:3px solid var(--verde)}
.objeto .icono{font-size:2.5rem;display:block;margin-bottom:.5rem}.objeto .nombre{font-weight:700;display:block}.objeto .pista{font-size:.78rem;color:var(--gris)}
.objeto.resuelto{cursor:default}.objeto.salvado{border-color:var(--verde);background:rgba(127,176,140,.15)}.objeto.desechado{border-color:var(--tierra);background:rgba(138,106,79,.13)}
.etiqueta{display:block;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;font-weight:700;margin-top:.5rem}.salvado .etiqueta{color:var(--verde)}.desechado .etiqueta{color:var(--tierra)}
.modal-fondo{position:fixed;inset:0;background:rgba(20,20,18,.65);backdrop-filter:blur(5px);display:flex;align-items:center;justify-content:center;padding:1rem;z-index:20;opacity:0;pointer-events:none;transition:.25s}
.modal-fondo.abierto{opacity:1;pointer-events:auto}.modal{background:var(--crema);color:var(--carbon);border-radius:var(--radio);width:min(650px,100%);max-height:90vh;overflow:auto;padding:2rem;transform:translateY(12px);transition:.25s}
.modal-fondo.abierto .modal{transform:none}.icono-grande{font-size:3rem}.modal h3{font-size:1.8rem;margin:.3rem 0}.origen{font-size:.78rem;color:var(--gris);text-transform:uppercase;letter-spacing:.08em;margin-bottom:1rem}
.modal p{margin-bottom:.8rem}.bloques{display:grid;gap:.7rem;margin:1rem 0}.bloque{padding:.85rem 1rem;border-radius:10px;background:rgba(127,176,140,.13);border-left:3px solid var(--verde2);font-size:.9rem}.bloque.reparar{background:rgba(61,102,137,.12);border-color:var(--azul)}.bloque.dano{background:rgba(168,68,58,.1);border-color:var(--rojo)}.bloque h4{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.35rem}.bloque ul{padding-left:1.2rem}.bloque li{margin:.2rem 0}
.acciones{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.2rem}.resultado{display:none;padding:1rem;border-radius:10px;margin-top:1rem}.resultado.visible{display:block}.resultado.bien{background:rgba(127,176,140,.2)}.resultado.mal{background:rgba(168,68,58,.13)}
.lienzo-envoltorio{height:390px;border-radius:var(--radio);overflow:hidden;background:#12110f;position:relative;border:1px solid var(--linea)}#arteCanvas{width:100%;height:100%;display:block}.lienzo-texto{position:absolute;left:1.3rem;bottom:1rem;color:#eee;font-size:.85rem;max-width:45ch;pointer-events:none;text-shadow:0 1px 4px #000}
.referencias{background:rgba(255,255,255,.65);border-top:1px solid var(--linea)}.referencias ul{list-style:none;display:grid;gap:.8rem}.referencias li{padding-left:1.2rem;position:relative;color:var(--gris)}.referencias li:before{content:"";position:absolute;left:0;top:.65em;width:7px;height:7px;border-radius:50%;background:var(--verde2)}a{color:var(--verde)}.nota{margin-top:2rem;color:var(--gris);font-size:.84rem}
.barra{position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);display:flex;gap:.3rem;flex-wrap:wrap;justify-content:center;background:rgba(30,28,25,.94);padding:.45rem;border-radius:99px;z-index:10;box-shadow:0 12px 30px #0004;max-width:calc(100% - 1rem)}
.barra button{background:transparent;border:0;color:#f6f3ec;padding:.6rem .85rem;border-radius:99px;cursor:pointer;font-size:.78rem;white-space:nowrap}.barra button:hover{background:#ffffff25}
footer{padding:2rem 0 6rem;text-align:center;color:var(--gris);font-size:.82rem}
@media(max-width:640px){.juego{padding:1rem}.modal{padding:1.3rem}.barra{width:calc(100% - 1rem)}.barra button{font-size:.68rem;padding:.55rem .6rem}.lienzo-envoltorio{height:320px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
