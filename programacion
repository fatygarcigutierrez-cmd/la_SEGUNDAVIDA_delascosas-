<script>
"use strict";
const OBJETOS=[
{id:"botella",icono:"🍾",nombre:"Botella de vidrio",categoria:"Vidrio",origen:"Cocina · hace 2 semanas",historia:"Se vació en una cena y quedó junto al fregadero. El vidrio puede reciclarse repetidamente sin perder sus propiedades principales.",reutilizar:["Enjuágala y úsala para guardar agua, legumbres o semillas.","Decórala y conviértela en florero o portavelas, sin exponerla a calor si está dañada.","Úsala como recipiente para materiales de pintura."],reparar:["Si tiene grietas, no la uses para alimentos ni líquidos.","Retira etiquetas con agua tibia y jabón.","Si está rota, deposítala en el sistema de recolección adecuado; protégela para evitar cortes."],dano:["Puede permanecer durante muchísimo tiempo en el ambiente.","Los fragmentos pueden provocar heridas a personas y animales.","Fabricar vidrio nuevo requiere altas temperaturas; reciclarlo puede ahorrar materias primas y energía."],salvar:"La limpiaste y la reutilizaste como florero o recipiente.",desechar:"La mezclaste con basura general y se perdió la oportunidad de recuperarla."},
{id:"camiseta",icono:"👕",nombre:"Camiseta de algodón",categoria:"Textil",origen:"Armario · hace 1 año",historia:"Perdió el color y ya no la usas, pero la tela todavía puede tener una función.",reutilizar:["Córtala en tiras y úsala como trapo de limpieza.","Dónala si está en buen estado.","Con varias prendas puedes crear una bolsa, tapete o pieza textil."],reparar:["Un agujero pequeño se puede cerrar con puntadas o un parche decorativo.","Vuelve a coser un dobladillo descosido.","Puedes teñirla o intervenirla artísticamente."],dano:["La producción textil requiere agua, energía y materias primas.","Las fibras sintéticas pueden liberar microfibras durante el lavado.","Desechar ropa aprovechable aumenta los residuos y desperdicia el trabajo invertido."],salvar:"La transformaste en un trapo, bolsa o pieza textil.",desechar:"La enviaste a la basura aunque todavía podía aprovecharse."},
{id:"movil",icono:"📱",nombre:"Teléfono antiguo",categoria:"Electrónica",origen:"Cajón · hace 4 años",historia:"El teléfono funciona con lentitud, pero contiene componentes y materiales que pueden recuperarse.",reutilizar:["Úsalo como reproductor de música, cámara o reloj.","Dónalo si todavía funciona y puede borrarse tu información personal.","Llévalo a un programa autorizado de recolección electrónica."],reparar:["Revisa si es posible cambiar la batería.","Libera espacio y actualiza o restaura el sistema con respaldo previo.","Consulta un servicio técnico antes de abrirlo."],dano:["Los residuos electrónicos requieren manejo especializado.","Algunos componentes contienen sustancias que pueden contaminar suelo y agua.","Recuperar materiales reduce la necesidad de extraer nuevos recursos."],salvar:"Lo reutilizaste o lo llevaste a un punto autorizado de reciclaje electrónico.",desechar:"Lo tiraste con residuos comunes y sus materiales quedaron sin recuperar."},
{id:"libro",icono:"📚",nombre:"Libro terminado",categoria:"Papel",origen:"Estantería · hace 3 años",historia:"Ya lo leíste y no volverás a abrirlo. Otro lector podría encontrar una nueva historia en sus páginas.",reutilizar:["Intercámbialo con alguien.","Dónalo a una biblioteca, escuela o centro comunitario.","Aprovecha hojas dañadas para bocetos o pruebas."],reparar:["Pega con cuidado un lomo suelto.","Refuerza páginas desprendidas con materiales adecuados.","Seca un libro húmedo con papel absorbente y ventilación."],dano:["Producir papel nuevo consume recursos forestales, agua y energía.","El papel limpio puede recuperarse mediante reciclaje.","La humedad y la grasa pueden dificultar su reciclaje."],salvar:"Lo intercambiaste o donaste para que otra persona lo lea.",desechar:"Lo tiraste sin considerar que podía seguir circulando."},
{id:"carton",icono:"📦",nombre:"Caja de cartón",categoria:"Papel",origen:"Después de una mudanza · hace 1 semana",historia:"Cumplió su función de transportar objetos. Su estructura todavía puede servir para crear y organizar.",reutilizar:["Úsala para almacenar materiales o hacer un organizador.","Conviértela en maqueta, escultura o soporte para bocetos.","Desármala y guárdala para otro envío."],reparar:["Refuerza esquinas con cinta de papel.","Recorta las partes dañadas para crear una caja más pequeña.","Mantén el cartón seco y limpio."],dano:["Si se contamina con grasa o humedad puede perder valor para el reciclaje.","La fabricación de cartón requiere fibras, agua y energía.","Mezclarlo con residuos orgánicos dificulta su recuperación."],salvar:"La reutilizaste para almacenar o crear una pieza artística.",desechar:"La mezclaste con residuos y perdió su potencial de reutilización."},
{id:"bolsa",icono:"🛍️",nombre:"Bolsa de plástico",categoria:"Plástico",origen:"Compras · hoy",historia:"Sirvió unos minutos para transportar compras. Si está limpia y entera, todavía puede utilizarse más veces.",reutilizar:["Guárdala y llévala de nuevo a comprar.","Úsala para separar objetos o proteger materiales.","Prefiere una bolsa durable para tus próximas compras."],reparar:["Si tiene una pequeña abertura, evita cargar objetos pesados.","No la calientes ni la uses cerca del fuego.","Si ya no es segura, busca un punto de acopio que acepte ese tipo de plástico."],dano:["Puede fragmentarse en piezas pequeñas que permanecen en el ambiente.","Puede afectar a la fauna si termina en ríos o mares.","Su producción depende de recursos fósiles."],salvar:"La reutilizaste varias veces y evitaste consumir otra bolsa.",desechar:"La tiraste después de un solo uso."},
{id:"lata",icono:"🥫",nombre:"Lata de aluminio",categoria:"Metal",origen:"Cocina · ayer",historia:"El envase está vacío. El aluminio puede recuperarse y convertirse en nuevos productos.",reutilizar:["Lávala y úsala como portalápices si no tiene bordes filosos.","Decórala como contenedor para pinceles.","Sepárala limpia para reciclaje."],reparar:["Aplana solo si el sistema local lo recomienda.","No uses latas con bordes cortantes como recipientes abiertos.","Retira restos de alimento antes de separarla."],dano:["Los envases mal dispuestos pueden acumularse en espacios públicos y naturales.","La extracción y producción de aluminio requieren mucha energía.","Reciclar aluminio reduce la demanda de materia prima."],salvar:"La convertiste en un objeto útil o la separaste para reciclarla.",desechar:"La tiraste con residuos mezclados y no pudo recuperarse fácilmente."},
{id:"frasco",icono:"🫙",nombre:"Frasco de vidrio",categoria:"Vidrio",origen:"Despensa · hace 3 días",historia:"El frasco conserva su forma y tapa. Puede tener una segunda función en casa o en el taller.",reutilizar:["Guarda botones, pigmentos secos o semillas.","Úsalo para organizar materiales pequeños.","Conviértelo en un pequeño contenedor decorativo."],reparar:["Lava y retira etiquetas con agua tibia.","Comprueba que la tapa cierre bien.","No utilices frascos astillados para almacenar alimentos."],dano:["El vidrio requiere energía para su fabricación y transporte.","Si se rompe puede causar lesiones.","Separarlo correctamente permite recuperar el material."],salvar:"Lo limpiaste y ahora organiza materiales de tu taller.",desechar:"Lo desechaste aunque podía cumplir otra función."},
{id:"pila",icono:"🔋",nombre:"Pila usada",categoria:"Electrónica",origen:"Cajón · hace 6 meses",historia:"Ya no tiene carga, pero no debe tratarse como basura común: necesita un manejo específico.",reutilizar:["No intentes recargar pilas desechables.","Guárdala temporalmente en un recipiente seco y fuera del alcance de niñas, niños y mascotas.","Llévala a un centro de acopio que reciba pilas."],reparar:["No la abras, perfores ni quemes.","Evita mezclar pilas dañadas con otras.","Sigue las indicaciones del punto de recolección."],dano:["Una pila mal dispuesta puede liberar sustancias contaminantes.","El manejo inadecuado representa riesgos para suelo y agua.","La recolección especializada permite gestionar sus componentes."],salvar:"La llevaste a un centro de acopio especializado.",desechar:"La colocaste en la basura común, una opción que debe evitarse."},
{id:"madera",icono:"🪵",nombre:"Retazo de madera",categoria:"Otros",origen:"Taller · hace 1 mes",historia:"Este retazo quedó después de un proyecto. Su forma irregular puede convertirse en el inicio de otra pieza.",reutilizar:["Úsalo como base para una pequeña escultura.","Crea un soporte para pinceles o herramientas.","Combina varios retazos en un collage tridimensional."],reparar:["Lija suavemente las astillas usando protección.","Une piezas con adhesivo o ensambles adecuados.","Aplica un acabado apropiado al uso que tendrá."],dano:["Desechar madera aprovechable desperdicia material y energía incorporada.","La madera tratada puede requerir una gestión especial.","Reutilizar retazos reduce la necesidad de consumir material nuevo."],salvar:"Lo convertiste en material para una nueva obra.",desechar:"Lo descartaste sin explorar su potencial creativo."}
];
const CATEGORIAS=["Todos",...new Set(OBJETOS.map(o=>o.categoria))];
let filtroActual="Todos", objetoActual=null, decisiones=leerEstado();
const $=id=>document.getElementById(id);
function leerEstado(){try{return JSON.parse(localStorage.getItem("segundaVidaODS12"))||{}}catch(e){return {}}}
function guardarEstado(){try{localStorage.setItem("segundaVidaODS12",JSON.stringify(decisiones))}catch(e){}}
function renderFiltros(){
 $("filtros").innerHTML="";
 CATEGORIAS.forEach(cat=>{const b=document.createElement("button");b.className="filtro"+(cat===filtroActual?" activo":"");b.textContent=cat;b.type="button";b.onclick=()=>{filtroActual=cat;renderFiltros();renderObjetos()};$("filtros").appendChild(b)});
}
function renderObjetos(){
 const rejilla=$("rejilla");rejilla.innerHTML="";
 OBJETOS.filter(o=>filtroActual==="Todos"||o.categoria===filtroActual).forEach(o=>{
  const estado=decisiones[o.id];const b=document.createElement("button");b.type="button";b.className="objeto"+(estado?" resuelto "+estado:"");b.setAttribute("aria-label",o.nombre+(estado?", "+estado:""));
  b.innerHTML=`<span class="icono">${o.icono}</span><span class="nombre">${o.nombre}</span><span class="pista">${o.categoria}</span>${estado?`<span class="etiqueta">${estado==="salvado"?"✓ Segunda vida":"Desechado"}</span>`:"<span class='pista'>Toca para explorar</span>"}`;
  b.onclick=()=>abrirObjeto(o);rejilla.appendChild(b);
 });
 actualizarMarcador();
}
function actualizarMarcador(){
 const valores=Object.values(decisiones),salvados=valores.filter(v=>v==="salvado").length,desechados=valores.filter(v=>v==="desechado").length,total=valores.length;
 $("numSalvados").textContent=salvados;$("numDesechados").textContent=desechados;$("numPuntaje").textContent=salvados*10;
 $("avanceTexto").textContent=`${total} de ${OBJETOS.length} objetos explorados`;$("progresoBarra").style.width=(total/OBJETOS.length*100)+"%";dibujarArte();
}
function lista(id,items){$(id).innerHTML=items.map(x=>`<li>${escapar(x)}</li>`).join("")}
function escapar(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function abrirObjeto(o){
 objetoActual=o;const estado=decisiones[o.id];
 $("modalIcono").textContent=o.icono;$("modalTitulo").textContent=o.nombre;$("modalOrigen").textContent=o.origen;$("modalHistoria").textContent=o.historia;
 lista("listaReutilizar",o.reutilizar);lista("listaReparar",o.reparar);lista("listaDano",o.dano);
 const res=$("resultado");res.className="resultado";res.textContent="";
 $("btnSalvar").disabled=!!estado;$("btnDesechar").disabled=!!estado;
 if(estado){res.className="resultado visible "+(estado==="salvado"?"bien":"mal");res.textContent=estado==="salvado"?o.salvar+" Ya registraste esta decisión.":o.desechar+" Ya registraste esta decisión."}
 $("modalFondo").classList.add("abierto");$("btnCerrar").focus();
}
function decidir(tipo){
 if(!objetoActual||decisiones[objetoActual.id])return;
 decisiones[objetoActual.id]=tipo;guardarEstado();const res=$("resultado");res.className="resultado visible "+(tipo==="salvado"?"bien":"mal");
 res.innerHTML=`<strong>${tipo==="salvado"?"¡Le diste una segunda vida! +10 puntos":"Objeto desechado"}</strong>${escapar(tipo==="salvado"?objetoActual.salvar:objetoActual.desechar)}`;
 $("btnSalvar").disabled=true;$("btnDesechar").disabled=true;renderObjetos();
}
function cerrarModal(){$("modalFondo").classList.remove("abierto");objetoActual=null}
$("btnSalvar").addEventListener("click",()=>decidir("salvado"));
$("btnDesechar").addEventListener("click",()=>decidir("desechado"));
$("btnCerrar").addEventListener("click",cerrarModal);
$("modalFondo").addEventListener("click",e=>{if(e.target===$("modalFondo"))cerrarModal()});
document.addEventListener("keydown",e=>{if(e.key==="Escape")cerrarModal()});
$("btnAleatorio").addEventListener("click",()=>{const pendientes=OBJETOS.filter(o=>!decisiones[o.id]);const listaPendiente=pendientes.length?pendientes:OBJETOS;abrirObjeto(listaPendiente[Math.floor(Math.random()*listaPendiente.length)])});
$("btnModo").addEventListener("click",()=>{document.body.classList.toggle("noche");$("btnModo").textContent=document.body.classList.contains("noche")?"☀ Modo claro":"◐ Modo oscuro"});
$("btnNueva").addEventListener("click",()=>{if(confirm("¿Quieres reiniciar la experiencia? Se borrarán tus decisiones y puntos guardados en este navegador.")){decisiones={};guardarEstado();renderObjetos();cerrarModal()}});
function dibujarArte(){
 const canvas=$("arteCanvas"),rect=canvas.getBoundingClientRect(),dpr=Math.min(window.devicePixelRatio||1,2),w=Math.max(1,rect.width),h=Math.max(1,rect.height);
 if(canvas.width!==Math.round(w*dpr)||canvas.height!==Math.round(h*dpr)){canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr)}
 const ctx=canvas.getContext("2d");ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,w,h);
 ctx.fillStyle="#12110f";ctx.fillRect(0,0,w,h);
 const salvados=Object.values(decisiones).filter(v=>v==="salvado").length,desechados=Object.values(decisiones).filter(v=>v==="desechado").length;
 const n=130+salvados*28+desechados*12;
 for(let i=0;i<n;i++){
  const t=i*2.39996+salvados*.17,x=w/2+Math.cos(t)*(18+i*(w*.0018)),y=h/2+Math.sin(t*.83)*(12+i*(h*.0017));
  const r=1.2+(i%5)*.55;ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);
  ctx.fillStyle=i%(Math.max(2,10-salvados))===0?"rgba(166,104,70,.75)":"rgba(127,176,140,"+(.22+(i%6)*.1)+")";ctx.fill();
 }
 ctx.strokeStyle="rgba(210,190,150,.2)";ctx.lineWidth=1;ctx.beginPath();ctx.ellipse(w/2,h/2,Math.min(w,h)*.28,Math.min(w,h)*.17,-.4,0,Math.PI*2);ctx.stroke();
 ctx.fillStyle="#f6f3ec";ctx.font="13px Arial";ctx.textAlign="center";ctx.fillText(`${salvados} salvados · ${desechados} desechados`,w/2,h-24);
}
window.addEventListener("resize",dibujarArte);
renderFiltros();renderObjetos();dibujarArte();
</script>
</body>
</html>
